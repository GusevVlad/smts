# Internal SMTS Production Environment Variables - EXAMPLE
# Copy to .env.int-prod.local and fill in real values
# DO NOT COMMIT .env.int-prod.local to git

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_PORT=8080
HEALTH_PATH=/health
HEALTH_INTERVAL=30s

# NATS Configuration
NATS_HOST=localhost
NATS_PORT=4222

# Artemis Configuration (host/port only - credentials in Vault)
ARTEMIS_HOST=your-artemis-host
ARTEMIS_PORT=61613
ARTEMIS_QUEUE=SMTS_INT_QUEUE

# DLP Configuration
DLP_ENDPOINT=https://dlp.corporate.com/validate
DLP_TIMEOUT=10s

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=REPLACE_WITH_INT_ROLE_ID
VAULT_SECRET_ID=REPLACE_WITH_INT_SECRET_ID