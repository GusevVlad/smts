# External SMTS Production Environment Variables - EXAMPLE
# Copy to .env.ext-prod.local and fill in real values
# DO NOT COMMIT .env.ext-prod.local to git

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_PORT=8080
HEALTH_PATH=/health
HEALTH_INTERVAL=30s

# NATS Configuration
NATS_HOST=localhost
NATS_PORT=4222

# Vault Configuration
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=REPLACE_WITH_EXT_ROLE_ID
VAULT_SECRET_ID=REPLACE_WITH_EXT_SECRET_ID

# Traffic Monitor Configuration (if provider = traffic_monitor)
TRAFFIC_MONITOR_AUTH_TOKEN=
TRAFFIC_MONITOR_COMPANY_ID=
TRAFFIC_MONITOR_BASE_URL=