# External SMTS Production Environment Variables
# NOTE: Secrets (API_KEY, etc.) are now stored in Vault
# This file contains only non-secret configuration

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_PORT=8080
HEALTH_PATH=/health
HEALTH_INTERVAL=30s

# NATS Configuration
NATS_HOST=localhost
NATS_PORT=4222

# Vault Configuration (address only - no secrets)
VAULT_ADDR=http://vault:8200
# VAULT_ROLE_ID and VAULT_SECRET_ID must be provided at runtime via environment variables