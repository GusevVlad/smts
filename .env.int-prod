# Internal SMTS Production Environment Variables
API_KEY=your-production-api-key-here
ARTEMIS_USER=admin
ARTEMIS_PASSWORD=your-secure-artemis-password-here

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check Configuration
HEALTH_PORT=8080
HEALTH_PATH=/health
HEALTH_INTERVAL=30s

# NATS Configuration
NATS_HOST=localhost
NATS_PORT=4222

# Artemis Configuration
ARTEMIS_HOST=your-artemis-host
ARTEMIS_PORT=61613
ARTEMIS_QUEUE=SMTS_INT_QUEUE

# DLP Configuration
DLP_ENDPOINT=https://dlp.corporate.com/validate
DLP_TIMEOUT=10s