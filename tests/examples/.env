# SMTS Test Environment Variables

# EXT SMTS API endpoints
API_BASE_URL_EXT=http://localhost:18092
API_BASE_URL_INT=http://localhost:18094

# Message API endpoints (for reading messages)
MESSAGE_API_EXT=http://localhost:19081
MESSAGE_API_INT=http://localhost:19083

# API Keys
API_KEY=test-api-key

# Topics
TOPIC_MONTERRA=test.monterra.event
TOPIC_PACT_UPDATE=test.pact_update.event

# Roles
ROLE_EXT_WRITER=ext_writer
ROLE_INT_WRITER=int_writer
ROLE_EXT_READER=ext_reader
ROLE_INT_READER=int_reader

# LDAP credentials for testing
# Test user WITH proper roles (for test-message-flow-ldap.sh)
LDAP_USERNAME=testuser
LDAP_PASSWORD=testpass

# Test user WITHOUT proper roles (for test-permission-failures.sh)
# This user should exist in LDAP but NOT be in any required groups
LDAP_USERNAME_NO_ROLES=norolesuser
LDAP_PASSWORD_NO_ROLES=norolespass